# Supabase Database Configuration (Example Template)
# Copia este archivo a un nuevo archivo llamado '.env' y reemplaza con tus credenciales.

# URL de conexión JDBC apuntando al Pooler
DB_URL=jdbc:postgresql://<TU-HOST-DE-SUPABASE-POOLER>:5432/postgres?sslmode=require

# Usuario de la base de datos
DB_USER=postgres.<TU-PROJECT-ID>

# Contraseña de la base de datos
DB_PASSWORD=<TU-CONTRASEÑA-DE-SUPABASE>

# Habilitar orígenes de CORS si es necesario
CORS_ORIGINS=http://localhost:5173
