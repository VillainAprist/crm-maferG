      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Inter:wght@500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  .aura-soft-enter { animation: auraSoftEnter 760ms cubic-bezier(.2,.8,.2,1) both; }\n  .aura-late-enter { animation: auraSoftEnter 840ms cubic-bezier(.2,.8,.2,1) 110ms both; }\n  .aura-dot-pulse { animation: auraDotPulse 2.8s ease-in-out infinite; }\n  .aura-strip::-webkit-scrollbar { display: none; }\n  .aura-strip { scrollbar-width: none; }\n  @keyframes auraSoftEnter {\n    from { transform: translateY(18px); opacity: .001; }\n    to { transform: translateY(0); opacity: 1; }\n  }\n  @keyframes auraDotPulse {\n    0%, 100% { transform: scaleX(1); opacity: 1; }\n    50% { transform: scaleX(.72); opacity: .72; }\n  }\n</style>\n\n<div class=\"min-h-screen w-full bg-[#EDEAE0] text-[#555555] overflow-x-clip\" style=\"font-family:'DM Sans', sans-serif;\" data-kid=\"1\">\n  <main class=\"mx-auto min-h-screen w-full max-w-[375px] bg-[#EDEAE0] pb-[126px] shadow-[0_0_0_1px_rgba(85,85,85,0.06)]\" data-kid=\"2\">\n    <section class=\"relative h-[70vh] min-h-[560px] bg-[#e4ddce]\" data-kid=\"3\">\n      <div class=\"absolute inset-0 overflow-hidden rounded-b-[34px]\" data-kid=\"4\">\n        <img src=\"https://images.unsplash.com/photo-1648066380643-675d30c3cd17?auto=format&w=900&q=80&fit=crop\" alt=\"Model wearing the Aura Threads Linen Trench Coat\" loading=\"lazy\" decoding=\"async\" class=\"h-full w-full object-cover object-[48%_50%]\" data-kid=\"5\">\n        <div class=\"absolute inset-0 bg-[linear-gradient(180deg,rgba(237,234,224,.55)_0%,rgba(237,234,224,.08)_28%,rgba(64,55,47,.04)_65%,rgba(45,40,36,.18)_100%)]\" data-kid=\"6\"></div>\n      </div>\n\n      <div class=\"absolute inset-x-0 top-0 z-10 flex items-center justify-between px-4 pt-4 text-[22px]\" data-kid=\"7\">\n        <button type=\"button\" aria-label=\"Back\" class=\"grid h-11 w-11 place-items-center rounded-full border border-[#555555]/10 bg-[#EDEAE0]/82 text-[#555555] shadow-[0_8px_28px_rgba(85,85,85,0.08)] backdrop-blur-sm\" data-kid=\"8\">\n          <i class=\"ti ti-arrow-left\" data-kid=\"9\"></i>\n        </button>\n        <div class=\"rounded-full border border-[#555555]/10 bg-[#EDEAE0]/76 px-4 py-2 text-[10px] font-bold tracking-[0.28em] text-[#555555] shadow-[0_8px_28px_rgba(85,85,85,0.06)] backdrop-blur-sm\" style=\"font-family:'Inter', sans-serif;\" data-kid=\"10\">AURA THREADS</div>\n        <button type=\"button\" aria-label=\"Add to wishlist\" class=\"relative grid h-11 w-11 place-items-center rounded-full border border-[#555555]/10 bg-[#EDEAE0]/82 text-[#555555] shadow-[0_8px_28px_rgba(85,85,85,0.08)] backdrop-blur-sm\" data-kid=\"11\">\n          <i class=\"ti ti-heart\" data-kid=\"12\"></i>\n          <span class=\"absolute right-2.5 top-2.5 h-2 w-2 rounded-full bg-[#FFE4E1]\" data-kid=\"13\"></span>\n        </button>\n      </div>\n\n      <div class=\"absolute bottom-5 left-1/2 z-10 flex -translate-x-1/2 items-center gap-2 rounded-full border border-[#EDEAE0]/55 bg-[#EDEAE0]/78 px-3.5 py-2.5 shadow-[0_10px_35px_rgba(65,58,50,0.12)] backdrop-blur-sm\" data-kid=\"14\">\n        <span class=\"aura-dot-pulse h-1.5 w-6 origin-center rounded-full bg-[#555555]\" data-kid=\"15\"></span>\n        <span class=\"h-1.5 w-1.5 rounded-full bg-[#555555]/32\" data-kid=\"16\"></span>\n        <span class=\"h-1.5 w-1.5 rounded-full bg-[#555555]/32\" data-kid=\"17\"></span>\n        <span class=\"h-1.5 w-1.5 rounded-full bg-[#555555]/32\" data-kid=\"18\"></span>\n      </div>\n    </section>\n\n    <section class=\"relative -mt-8 rounded-t-[32px] bg-[#EDEAE0] px-5 pt-5 aura-soft-enter\" data-kid=\"19\">\n      <div class=\"mx-auto mb-6 h-1 w-11 rounded-full bg-[#555555]/18\" data-kid=\"20\"></div>\n\n      <div class=\"mb-5 flex items-start justify-between gap-4\" data-kid=\"21\">\n        <div data-kid=\"22\">\n          <p class=\"mb-2 text-[10px] font-bold uppercase tracking-[0.24em] text-[#555555]/55\" style=\"font-family:'Inter', sans-serif;\" data-kid=\"23\">Outerwear · Spring linen</p>\n          <h1 class=\"max-w-[230px] text-[31px] font-semibold leading-[1.02] tracking-[-0.045em] text-[#555555]\" style=\"font-family:'Inter', sans-serif;\" data-kid=\"24\">Linen Trench Coat</h1>\n        </div>\n        <div class=\"rounded-full bg-[#FFE4E1] px-4 py-2 text-[18px] font-semibold tracking-[-0.03em] text-[#555555]\" data-kid=\"25\">$248</div>\n      </div>\n\n      <div class=\"aura-strip -mx-5 mb-7 flex gap-2.5 overflow-x-auto px-5 pb-1\" data-kid=\"26\">\n        <button type=\"button\" aria-label=\"View image 1\" class=\"h-[76px] w-[58px] shrink-0 overflow-hidden rounded-[16px] border-2 border-[#555555] bg-[#e2dacb] p-0.5\" data-kid=\"27\">\n          <img src=\"https://images.unsplash.com/photo-1648066380643-675d30c3cd17?auto=format&w=180&q=80&fit=crop\" alt=\"Front angle thumbnail\" loading=\"lazy\" decoding=\"async\" class=\"h-full w-full rounded-[13px] object-cover\" data-kid=\"28\">\n        </button>\n        <button type=\"button\" aria-label=\"View image 2\" class=\"h-[76px] w-[58px] shrink-0 overflow-hidden rounded-[16px] border border-[#555555]/14 bg-[#e2dacb] p-0.5\" data-kid=\"29\">\n          <img src=\"https://images.unsplash.com/photo-1672370751361-f5e825e28265?auto=format&w=180&q=80&fit=crop\" alt=\"Back angle thumbnail\" loading=\"lazy\" decoding=\"async\" class=\"h-full w-full rounded-[14px] object-cover\" data-kid=\"30\">\n        </button>\n        <button type=\"button\" aria-label=\"View image 3\" class=\"h-[76px] w-[58px] shrink-0 overflow-hidden rounded-[16px] border border-[#555555]/14 bg-[#e2dacb] p-0.5\" data-kid=\"31\">\n          <img src=\"https://images.unsplash.com/photo-1672335518593-6e094c81c782?auto=format&w=180&q=80&fit=crop\" alt=\"Outdoor styling thumbnail\" loading=\"lazy\" decoding=\"async\" class=\"h-full w-full rounded-[14px] object-cover\" data-kid=\"32\">\n        </button>\n        <button type=\"button\" aria-label=\"View fabric detail\" class=\"h-[76px] w-[58px] shrink-0 overflow-hidden rounded-[16px] border border-[#555555]/14 bg-[#e2dacb] p-0.5\" data-kid=\"33\">\n          <img src=\"https://images.unsplash.com/photo-1634665810235-011d663754e7?auto=format&w=180&q=80&fit=crop\" alt=\"Linen fabric detail thumbnail\" loading=\"lazy\" decoding=\"async\" class=\"h-full w-full rounded-[14px] object-cover\" data-kid=\"34\">\n        </button>\n        <div class=\"flex h-[76px] w-[92px] shrink-0 flex-col justify-between rounded-[16px] border border-[#555555]/18 px-3 py-3\" data-kid=\"35\">\n          <span class=\"text-[10px] font-bold uppercase tracking-[0.2em] text-[#555555]/50\" data-kid=\"36\">Gallery</span>\n          <span class=\"text-[12px] leading-4 text-[#555555]/78\" data-kid=\"37\">4 quiet angles</span>\n        </div>\n      </div>\n\n      <div class=\"mb-11 border-y border-[#555555]/10 py-6\" data-kid=\"38\">\n        <p class=\"text-[15px] leading-7 text-[#555555]/82\" data-kid=\"39\">A softly structured trench cut from breathable linen twill. Designed with a relaxed shoulder, clean storm flap, and removable self belt for an effortless Nordic silhouette.</p>\n      </div>\n\n      <div class=\"mb-10\" data-kid=\"40\">\n        <div class=\"mb-3 flex items-end justify-between\" data-kid=\"41\">\n          <h2 class=\"text-[12px] font-bold uppercase tracking-[0.2em] text-[#555555]/58\" style=\"font-family:'Inter', sans-serif;\" data-kid=\"42\">Color</h2>\n          <span class=\"text-[13px] font-medium text-[#555555]\" data-kid=\"43\">Oat selected</span>\n        </div>\n        <div class=\"flex items-center gap-4\" data-kid=\"44\">\n          <button type=\"button\" aria-label=\"Oat color selected\" class=\"grid h-11 w-11 place-items-center rounded-full border border-[#555555] bg-transparent\" data-kid=\"45\">\n            <span class=\"h-8 w-8 rounded-full border border-[#555555]/12 bg-[#D8CCB7]\" data-kid=\"46\"></span>\n          </button>\n          <button type=\"button\" aria-label=\"Charcoal color\" class=\"grid h-11 w-11 place-items-center rounded-full border border-[#555555]/12 bg-transparent\" data-kid=\"47\">\n            <span class=\"h-8 w-8 rounded-full bg-[#4E4C48]\" data-kid=\"48\"></span>\n          </button>\n          <button type=\"button\" aria-label=\"Clay color\" class=\"grid h-11 w-11 place-items-center rounded-full border border-[#555555]/12 bg-transparent\" data-kid=\"49\">\n            <span class=\"h-8 w-8 rounded-full bg-[#B88972]\" data-kid=\"50\"></span>\n          </button>\n        </div>\n      </div>\n\n      <div class=\"mb-11\" data-kid=\"51\">\n        <div class=\"mb-3 flex items-end justify-between\" data-kid=\"52\">\n          <h2 class=\"text-[12px] font-bold uppercase tracking-[0.2em] text-[#555555]/58\" style=\"font-family:'Inter', sans-serif;\" data-kid=\"53\">Size</h2>\n          <button type=\"button\" class=\"text-[13px] font-medium text-[#555555]/70 underline decoration-[#555555]/25 underline-offset-4\" data-kid=\"54\">Size guide</button>\n        </div>\n        <div class=\"grid grid-cols-5 gap-2.5\" data-kid=\"55\">\n          <button type=\"button\" class=\"h-12 rounded-[14px] border border-[#555555]/16 bg-transparent text-[13px] font-semibold text-[#555555]/78\" data-kid=\"56\">XS</button>\n          <button type=\"button\" class=\"h-12 rounded-[14px] border border-[#555555]/16 bg-transparent text-[13px] font-semibold text-[#555555]/78\" data-kid=\"57\">S</button>\n          <button type=\"button\" class=\"h-12 rounded-[14px] border border-[#555555] bg-[#555555] text-[13px] font-semibold text-[#EDEAE0]\" data-kid=\"58\">M</button>\n          <button type=\"button\" class=\"h-12 rounded-[14px] border border-[#555555]/16 bg-transparent text-[13px] font-semibold text-[#555555]/78\" data-kid=\"59\">L</button>\n          <button type=\"button\" class=\"h-12 rounded-[14px] border border-[#555555]/16 bg-transparent text-[13px] font-semibold text-[#555555]/78\" data-kid=\"60\">XL</button>\n        </div>\n      </div>\n\n      <div class=\"mb-11 grid grid-cols-[78px_1fr] gap-5 border-t border-[#555555]/10 pt-7 aura-late-enter\" data-kid=\"61\">\n        <img src=\"https://images.unsplash.com/photo-1634665810235-011d663754e7?auto=format&w=500&q=80&fit=crop\" alt=\"Close up of oat linen fabric texture\" loading=\"lazy\" decoding=\"async\" class=\"h-[104px] w-[78px] rounded-[18px] object-cover\" data-kid=\"62\">\n        <div class=\"pt-0.5\" data-kid=\"63\">\n          <h2 class=\"mb-3 text-[12px] font-bold uppercase tracking-[0.2em] text-[#555555]/58\" style=\"font-family:'Inter', sans-serif;\" data-kid=\"64\">Fabric & care</h2>\n          <p class=\"text-[14px] leading-6 text-[#555555]/82\" data-kid=\"65\"><span class=\"font-semibold text-[#555555]\" data-kid=\"66\">72% linen, 28% organic cotton.</span> Machine wash cold, gentle cycle. Line dry in shade; warm iron to restore crispness.</p>\n        </div>\n      </div>\n\n      <div class=\"mb-10 divide-y divide-[#555555]/10 border-y border-[#555555]/10\" data-kid=\"67\">\n        <div class=\"flex gap-3 py-5 text-[18px]\" data-kid=\"68\">\n          <i class=\"ti ti-truck-delivery mt-0.5\" data-kid=\"69\"></i>\n          <div data-kid=\"70\">\n            <p class=\"text-[14px] font-semibold text-[#555555]\" data-kid=\"71\">Ships in 1–2 business days</p>\n            <p class=\"mt-1 text-[13px] leading-5 text-[#555555]/68\" data-kid=\"72\">Carbon-neutral delivery in recyclable linen paper.</p>\n          </div>\n        </div>\n        <div class=\"flex gap-3 py-5 text-[18px]\" data-kid=\"73\">\n          <i class=\"ti ti-refresh mt-0.5\" data-kid=\"74\"></i>\n          <div data-kid=\"75\">\n            <p class=\"text-[14px] font-semibold text-[#555555]\" data-kid=\"76\">Free 30-day returns</p>\n            <p class=\"mt-1 text-[13px] leading-5 text-[#555555]/68\" data-kid=\"77\">Try at home. Return unworn pieces with the original tag.</p>\n          </div>\n        </div>\n      </div>\n    </section>\n  </main>\n\n  <div class=\"fixed inset-x-0 bottom-0 z-20 mx-auto w-full max-w-[375px] border-t border-[#555555]/10 bg-[#EDEAE0]/94 px-4 pb-[calc(env(safe-area-inset-bottom)+14px)] pt-3 shadow-[0_-16px_42px_rgba(85,85,85,0.10)] backdrop-blur-md\" data-kid=\"78\">\n    <div class=\"mb-3 flex items-center justify-between\" data-kid=\"79\">\n      <div class=\"flex items-center gap-2 rounded-full border border-[#555555]/12 bg-[#F5F1E8]/70 p-1\" data-kid=\"80\">\n        <button type=\"button\" aria-label=\"Decrease quantity\" class=\"grid h-8 w-8 place-items-center rounded-full text-[17px] text-[#555555]\" data-kid=\"81\"><i class=\"ti ti-minus\" data-kid=\"82\"></i></button>\n        <span class=\"min-w-5 text-center text-[14px] font-semibold\" data-kid=\"83\">1</span>\n        <button type=\"button\" aria-label=\"Increase quantity\" class=\"grid h-8 w-8 place-items-center rounded-full bg-[#FFE4E1] text-[17px] text-[#555555]\" data-kid=\"84\"><i class=\"ti ti-plus\" data-kid=\"85\"></i></button>\n      </div>\n      <div class=\"text-right\" data-kid=\"86\">\n        <p class=\"text-[10px] font-bold uppercase tracking-[0.22em] text-[#555555]/48\" style=\"font-family:'Inter', sans-serif;\" data-kid=\"87\">M · Oat · Total</p>\n        <p class=\"text-[18px] font-semibold tracking-[-0.03em] text-[#555555]\" data-kid=\"88\">$248</p>\n      </div>\n    </div>\n    <button type=\"button\" class=\"flex h-14 w-full items-center justify-center gap-2 rounded-[18px] bg-[#555555] text-[15px] font-semibold tracking-[-0.01em] text-[#EDEAE0] shadow-[0_14px_30px_rgba(85,85,85,0.18)]\" data-kid=\"89\">\n      Add to Cart\n      <i class=\"ti ti-shopping-bag text-[19px]\" data-kid=\"90\"></i>\n    </button>\n  </div>\n</div>",
